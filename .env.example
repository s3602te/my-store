# 環境變數範本。使用方式:複製成 .env(.env 不會被上傳到 GitHub),再依需要修改。
#   Windows PowerShell:  Copy-Item .env.example .env
#   Git Bash:            cp .env.example .env
#
# ⚠️ 這裡的值只供「本機開發」使用。正式環境請使用另外產生的強密碼,且絕對不要寫進這個範本。

# --- 資料庫(docker-compose.yml 與後端共用)---
POSTGRES_USER=mystore
POSTGRES_PASSWORD=dev_only_change_me
POSTGRES_DB=mystore
POSTGRES_PORT=5432

# 後端連線字串。帳號、密碼、埠號要和上面一致;密碼若有特殊字元(@ : / # 等)需要做 URL 編碼。
DATABASE_URL=postgresql://mystore:dev_only_change_me@localhost:5432/mystore

# --- 後端(apps/api)---
API_HOST=127.0.0.1
API_PORT=3000
# 允許呼叫後端的前端網址(用逗號分隔)。之後前端上線的網址也要加進來
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 這個後端負責的店家,對應資料庫 Store.slug
STORE_SLUG=my-store

# --- 員工登入與安全(都有預設值,不改也能用)---
# 登入後多久過期(小時)
# SESSION_TTL_HOURS=12
# 連續輸錯幾次密碼就鎖定帳號、鎖定幾分鐘
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCK_MINUTES=15
# 登入 Cookie 的 SameSite:lax(前後端在同一個網站底下,預設、最安全)/ none(前後端網域完全不同時才用,需要 HTTPS)
# COOKIE_SAMESITE=lax
# 是否啟用「同一個 IP 呼叫太頻繁就暫時擋下」
# RATE_LIMIT_ENABLED=true
# 後端前面有反向代理(Nginx、雲端平台)時才設 true
# TRUST_PROXY=false
# 是否提供 /docs(API 說明與測試頁面)。開發預設開啟,正式環境預設關閉
# ENABLE_DOCS=true
