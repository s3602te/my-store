# 環境變數範本。使用方式:複製成 .env(.env 不會被上傳到 GitHub),再依需要修改。
#   Windows PowerShell:  Copy-Item .env.example .env
#   Git Bash:            cp .env.example .env
#
# ⚠️ 這裡的值只供「本機開發」使用。正式環境請使用另外產生的強密碼,且絕對不要寫進這個範本。

# --- 資料庫(docker-compose.yml 與後端共用)---
POSTGRES_USER=mystore
POSTGRES_PASSWORD=dev_only_change_me
POSTGRES_DB=mystore
POSTGRES_PORT=5432

# 後端連線字串。帳號、密碼、埠號要和上面一致;密碼若有特殊字元(@ : / # 等)需要做 URL 編碼。
DATABASE_URL=postgresql://mystore:dev_only_change_me@localhost:5432/mystore

# --- 後端(apps/api)---
API_HOST=127.0.0.1
API_PORT=3000
# 允許呼叫後端的前端網址(用逗號分隔)。之後前端上線的網址也要加進來
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 這個後端負責的店家,對應資料庫 Store.slug
STORE_SLUG=my-store
